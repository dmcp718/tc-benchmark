<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hardened-runtime entitlements required by PyInstaller onefile binaries:
     the bootloader maps the embedded CPython and extension modules into
     executable memory at run time, which the hardened runtime forbids
     without these two exceptions. Needed for notarization (Apple requires
     the hardened runtime), harmless for ad-hoc dev builds. -->
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
